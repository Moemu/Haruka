{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://haruka.example.com/schema/envelope.schema.json",
  "title": "Haruka ingest envelope",
  "description": "POST /v1/ingest 请求体。type 与 data 的对应关系由 allOf/if-then 约束；服务端以严格模式校验，未知字段一律拒绝。",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "device_id", "device_kind", "sent_at", "events"],
  "properties": {
    "v": { "const": 1 },
    "device_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
    "device_kind": { "enum": ["desktop", "android"] },
    "sent_at": { "type": "string", "format": "date-time" },
    "snapshot": { "type": "boolean" },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/event" }
    }
  },
  "$defs": {
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "seq", "ts", "type", "data"],
      "properties": {
        "id": { "type": "string", "pattern": "^e_[0-9a-f]{32}$" },
        "seq": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
        "ts": { "type": "string", "format": "date-time" },
        "type": { "enum": ["heartbeat", "presence", "activity", "location", "custom", "device"] },
        "data": true
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "heartbeat" } } },
          "then": { "properties": { "data": { "$ref": "#/$defs/heartbeatData" } } }
        },
        {
          "if": { "properties": { "type": { "const": "presence" } } },
          "then": { "properties": { "data": { "$ref": "#/$defs/presenceData" } } }
        },
        {
          "if": { "properties": { "type": { "const": "activity" } } },
          "then": { "properties": { "data": { "$ref": "#/$defs/activityData" } } }
        },
        {
          "if": { "properties": { "type": { "const": "location" } } },
          "then": { "properties": { "data": { "$ref": "#/$defs/locationData" } } }
        },
        {
          "if": { "properties": { "type": { "const": "custom" } } },
          "then": { "properties": { "data": { "$ref": "#/$defs/customData" } } }
        },
        {
          "if": { "properties": { "type": { "const": "device" } } },
          "then": { "properties": { "data": { "$ref": "#/$defs/deviceData" } } }
        }
      ]
    },
    "heartbeatData": {
      "type": "object",
      "additionalProperties": false
    },
    "presenceData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "idle_minutes"],
      "properties": {
        "state": { "enum": ["active", "away"] },
        "idle_minutes": { "type": "integer", "minimum": 0, "maximum": 10080 }
      }
    },
    "activityData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["ide", "browser", "app", "private", "idle", "none"] },
        "app": { "type": "string", "maxLength": 64 },
        "category": { "enum": ["coding", "writing", "browsing", "design", "meeting", "media", "music", "private", "other", "", null] },
        "file_type": { "type": "string", "pattern": "^\\.[a-z0-9]{1,8}$" }
      }
    },
    "deviceData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["battery_level"],
      "properties": {
        "battery_level": { "type": "integer", "minimum": 0, "maximum": 100 },
        "charging": { "type": "boolean" },
        "steps": { "type": "integer", "minimum": 0, "maximum": 1000000 }
      }
    },
    "locationData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "precision"],
      "properties": {
        "source": { "enum": ["ip", "gps_coarse", "manual"] },
        "precision": { "enum": ["country", "province", "city", "district"] },
        "country": { "type": "string", "maxLength": 64 },
        "province": { "type": ["string", "null"], "maxLength": 64 },
        "city": { "type": ["string", "null"], "maxLength": 64 },
        "district": { "type": ["string", "null"], "maxLength": 64 },
        "zone": { "enum": ["home", "school", null] }
      }
    },
    "customData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "payload"],
      "description": "插件数据信封：source 与插件名同一身份规则；payload 为插件定义的 JSON 对象（服务端限 2KB），语义由订阅同名 source 的插件定义。",
      "properties": {
        "source": { "type": "string", "pattern": "^[a-z0-9_-]{1,32}$" },
        "payload": { "type": "object" }
      }
    }
  }
}
